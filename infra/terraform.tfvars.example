# Copy to terraform.tfvars (which git ignores) and fill in.
alert_email = "you@example.com"

# The Region your project was assigned: AWS Settings, Projects, open the project, "Additional info". A new free-plan project in India is ap-southeast-2 (Sydney).
region = "ap-southeast-2"

