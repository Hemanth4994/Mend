# Copy to terraform.tfvars (which git ignores) and fill in.
alert_email = "you@example.com"

# The Region your account was assigned: AWS Console, top right, Account, "AWS Settings". A new free-plan account in India is usually ap-southeast-2 (Sydney).
region = "ap-southeast-2"

# monthly_budget_usd = 5
# create_budget      = false   # only if apply says your account may not create budgets
