# Copy of the file python orchestration/make_env.py writes as orchestration/.env (which git ignores). Names only: no real values here.
MEND_KESTRA_USER=you@example.com
MEND_KESTRA_PASSWORD=Replace1Me
# base64 of your Gemini API key; make_env.py computes it so the key never goes through your shell history
SECRET_GOOGLE_API_KEY=
# Optional S3 archive (after `terraform apply` in infra/; see infra/README.md). Leave empty to archive nothing.
MEND_ARCHIVE_BUCKET=
MEND_ARCHIVE_REGION=
# base64 of the access key of the mend-archive-writer user; make_env.py computes them
SECRET_AWS_ACCESS_KEY_ID=
SECRET_AWS_SECRET_ACCESS_KEY=
# Only if something else on your machine already uses port 8080 (Kestra's page is then http://localhost:<this port>):
# MEND_KESTRA_PORT=8088
