# Copy of the file python orchestration/make_env.py writes as orchestration/.env (which git ignores). Names only: no real values here.
MEND_KESTRA_USER=you@example.com
MEND_KESTRA_PASSWORD=Replace1Me
# base64 of your Gemini API key; make_env.py computes it so the key never goes through your shell history
SECRET_GOOGLE_API_KEY=
